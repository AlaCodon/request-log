/**
 * Wrangler Configuration for Request Log Worker
 * 
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	
	/**
	 * Worker Configuration
	 */
	"name": "request-log",
	"main": "src/index.ts",
	"compatibility_date": "2025-04-12",
	
	/**
	 * Observability & Monitoring
	 * Enables enhanced logging, metrics, and tracing for better debugging
	 */
	"observability": {
		"enabled": true
	},

	/**
	 * Smart Placement (Optional)
	 * Automatically places your Worker closer to your users and data sources
	 * Uncomment to enable Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },

	/**
	 * Environment Variables (Optional)
	 * Define non-sensitive configuration values here
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 * 
	 * Example:
	 */
	// "vars": { 
	//   "LOG_LEVEL": "info",
	//   "MAX_BODY_SIZE": "1024",
	//   "ALLOWED_ORIGINS": "https://example.com,https://api.example.com"
	// },

	/**
	 * Secrets (Sensitive Data)
	 * Use `wrangler secret put SECRET_NAME` to set sensitive values
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 * 
	 * Examples of secrets you might need:
	 * - API_SECRET_KEY
	 * - DATABASE_PASSWORD
	 * - WEBHOOK_SIGNING_SECRET
	 */

	/**
	 * KV Namespaces (Optional)
	 * For storing logged requests or configuration data
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#kv-namespaces
	 */
	// "kv_namespaces": [
	//   { "binding": "REQUEST_LOGS", "id": "your-kv-namespace-id" }
	// ],

	/**
	 * Durable Objects (Optional)
	 * For stateful request processing or rate limiting
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#durable-objects
	 */
	// "durable_objects": {
	//   "bindings": [
	//     { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
	//   ]
	// },

	/**
	 * Static Assets (Optional)
	 * Serve static files alongside your worker
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { 
	//   "directory": "./public/", 
	//   "binding": "ASSETS" 
	// },

	/**
	 * Service Bindings (Optional)
	 * Communicate between multiple Workers
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [
	//   { "binding": "LOG_PROCESSOR", "service": "log-processor-worker" }
	// ],

	/**
	 * Custom Domains (Optional)
	 * Configure custom domains for your worker
	 * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	 */
	// "routes": [
	//   { "pattern": "api.yourdomain.com/webhook/*", "custom_domain": true }
	// ],

	/**
	 * Limits (Optional)
	 * Configure resource limits for your worker
	 */
	// "limits": {
	//   "cpu_ms": 50
	// }
}
